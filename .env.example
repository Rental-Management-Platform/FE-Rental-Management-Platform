# Copy this file to .env.local and adjust. .env.local is ignored by git.
#
# Use "localhost" on both sides, never 127.0.0.1: the refresh cookie is tied to the host.
# The frontend runs on port 5173 (see the dev and start scripts). The API runs on 3000.
# The backend must list the frontend origin in ALLOWED_ORIGINS (http://localhost:5173).

# API address the browser calls. Written into the browser bundle at build time, so a change
# needs a rebuild. Absolute, or a path such as /api/v1 if the API is later proxied by Next.js.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# API address the Next.js server calls. Optional: falls back to NEXT_PUBLIC_API_URL.
# Must be absolute. Needed only when the server reaches the API at a different address.
# API_URL=http://localhost:3000/api/v1

# Public address of this site. Used for metadataBase, canonical and share URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:5173

# NOTE: next build fetches cached catalogs (wards, amenities, plans) from the API once those
# pages exist, so the API must be running and seeded at API_URL while you build.
