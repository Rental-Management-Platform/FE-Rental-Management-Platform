# Copy this file to .env next to compose.yaml on the server (chmod 600). .env is ignored by git.
# These are read by `docker compose` only. They hold no secret: the frontend has none.

# Public address of the site, with no trailing slash. It goes into canonical links, share cards and
# the sitemap, so a new domain needs a new build. The backend manager must have the same address
# in ALLOWED_ORIGINS and APP_BASE_URL, or the refresh call is a 403 and people lose the session.
SITE_URL=https://example.com

# Image tag. Use a new one for each release (WEB_TAG=20261121-1430 docker compose build), so the
# old image stays on the machine for a rollback.
WEB_TAG=local

# How `next build` reaches the running API. The defaults fit the server: the host network, and the
# port the backend publishes on loopback. To build on a computer where the API runs on the host
# (Docker Desktop), use BUILD_NETWORK=default and
# BUILD_API_URL=http://host.docker.internal:3000/api/v1
# BUILD_NETWORK=host
# BUILD_API_URL=http://127.0.0.1:3000/api/v1
